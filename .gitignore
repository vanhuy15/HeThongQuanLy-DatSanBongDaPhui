# ====================================================
# .gitignore — Hệ Thống Quản Lý Sân Bóng
# ====================================================

# =========================
# 🔐 BẢO MẬT - QUAN TRỌNG
# =========================
.env
*.env
.env.local
.env.production

# =========================
# 📁 UPLOADED FILES
# =========================
images/avatar/*
!images/avatar/.gitkeep
images/san_bong/*
!images/san_bong/.gitkeep

# =========================
# 📦 DEPENDENCIES
# =========================
vendor/
composer.lock

# =========================
# 💻 IDE & EDITOR
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# 🖥️ OS FILES
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# 🌐 PHP / SERVER
# =========================
*.log
logs/
storage/
database/backups/
error_log
php_errors.log
scripts/*.exe
scripts/cloudflared.exe
scripts/start_tunnel.bat

# =========================
# 📊 EXPORTS TẠM THỜI
# =========================
*.xlsx
*.xls
exports/

# =========================
# 🧪 TESTING & BUILD ARTIFACTS
# =========================
node_modules/
playwright-report/
test-results/
.phpunit.result.cache
.phpunit.cache/
tester/**/playwright-report/
tester/**/test-results/
tester/**/.phpunit.result.cache
tester/**/.phpunit.cache/
tester/06_code_coverage/report/
tester/preview_*.png
*.jtl
report_read/
report_race/
*.docx
*.pdf


