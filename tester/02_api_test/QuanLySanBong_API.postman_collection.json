          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "try {",
                  "    var res = pm.response.json();",
                  "    if (res.success && res.dat_san_id) {",
                  "        pm.environment.set(\"latest_booking_id\", res.dat_san_id);",
                  "    pm.collectionVariables.set(\"latest_booking_id\", res.dat_san_id);",
                  "        console.log('Created dynamic booking ID:', res.dat_san_id);",
                  "    } else {",
                  "        pm.environment.set(\"latest_booking_id\", '135');",
                  "    pm.collectionVariables.set(\"latest_booking_id\", '135');",
                  "    }",
                  "} catch(e) {",
                  "    pm.environment.set(\"latest_booking_id\", '135');",
                  "    pm.collectionVariables.set(\"latest_booking_id\", '135');",
                  "}"
                ]
              }
