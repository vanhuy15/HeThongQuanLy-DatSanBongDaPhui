        {
          "name": "TC00 - Khởi tạo phiên & Trích xuất CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200\", function () { pm.response.to.have.status(200); });",
                  "const html = pm.response.text();",
                  "const match = html.match(/name=\"csrf_token\"\\s+value=\"([a-f0-9]{64})\"/);",
                  "if (match) { pm.environment.set(\"csrf_token\", match[1]);",
                  "    pm.collectionVariables.set(\"csrf_token\", match[1]); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost/quanlysanbong/auth/login",
              "host": [
                "localhost"
              ],
              "path": [
                "quanlysanbong",
                "auth",
                "login"
              ],
              "query": [],
              "protocol": "http"
            }
          }
        },
        {
          "name": "TC00_B - Chặn truy cập đặt sân khi chưa đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chuyển hướng hoặc báo lỗi yêu cầu đăng nhập (302/200)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "    if (pm.response.code === 302) {",
                  "        pm.expect(pm.response.headers.get('Location') || '').to.include('action=login');",
                  "    } else {",
                  "        pm.expect(pm.response.text()).to.match(/action=login|đăng nhập/i);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
